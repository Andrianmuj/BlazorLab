@* Settings.razor *@

<h3>Real World Use Case Example Toggle Switch</h3>
<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" @bind="isChecked" @bind:after="NotifyChange" id="toggleSwitch">
    <label class="form-check-label" for="toggleSwitch">Toggle Status</label>
</div>


@code {
    // State to hold the current toggle value
    private bool isChecked = false;

    // 1. Define the EventCallback with a bool parameter
    [Parameter]
    public EventCallback<bool> OnToggleChange { get; set; }

    // 2. Method to invoke the EventCallback
    private async Task NotifyChange()
    {
        // Invokes the Toggle method in the parent component, passing the new state
        await OnToggleChange.InvokeAsync(isChecked);
    }
}