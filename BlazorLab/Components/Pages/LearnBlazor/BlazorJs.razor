@page "/learn-blazor/blazor-js"
@inject IJSRuntime _JSRuntime

<h3>BlazorJs</h3>
<br />

<div class="row">
    <button class="btn btn-secondary" style="width:200px" @onclick="ConfirmAction">Confirm Button</button>
</div>

<div>
    @if (ConfirmResult)
    {
        <p>Confirmation has been made!</p>
    }
    else
    {
        <p>Pending Confirmation</p>
    }
</div>

<div class="row">
    <button class="btn btn-success" style="width:200px" @onclick="ViewResult">View Result</button>
</div>

<div>
    @if (ViewResultStatus)
    {
        <p>You pass the test. Congratulations</p>
    }
    else
    {
        <p>The result view here</p>
    }
</div>

<div class="row">
    <button class="btn btn-success m-2" style="width:200px" @onclick="ToastSuccess">Toastr success </button>
    <button class="btn btn-danger m-2" style="width:200px" @onclick="ToastError">Toastr error </button>

    <button class="btn btn-info m-2" style="width:200px" @onclick="ToastInfo">Toastr info </button>
    <button class="btn btn-warning m-2" style="width:200px" @onclick="ToastWarning">Toastr warning </button>

</div>


<div class="row">
    <button class="btn btn-success m-2" style="width:200px" @onclick="SweetAlertSuccess">Toastr success </button>
    <button class="btn btn-danger m-2" style="width:200px" @onclick="SweetAlertError">Toastr error </button>

    <button class="btn btn-info m-2" style="width:200px" @onclick="SweetAlertInfo">Sweetalert Success </button>
    <button class="btn btn-warning m-2" style="width:200px" @onclick="SweetAlertWarning">Toastr warning </button>

</div>

@code {

    private string ConfirmMessage = "Are you sure you want to proceed?";

    private string Message = "Do you want to View the Result?";

    private bool ConfirmResult { get; set; }

    private bool ViewResultStatus { get; set; }

    private async Task ConfirmAction()
    {
        ConfirmResult = await _JSRuntime.InvokeAsync<bool>("confirm", ConfirmMessage);
    }

    private async Task ViewResult()
    {
        ViewResultStatus = await _JSRuntime.InvokeAsync<bool>("confirm", Message);
    }


    private async Task ToastSuccess()
    {
        // await _JSRuntime.InvokeVoidAsync("showToastr", "success", "Operation Successful");
        await _JSRuntime.ToastSuccess("Operation Successful");
    }

    private async Task ToastError()
    {
        //await _JSRuntime.InvokeVoidAsync("showToastr", "error", "Operation Failed
        await _JSRuntime.ToastError("Operation Failed");
    }

    private async Task ToastInfo()
    {
        //await _JSRuntime.InvokeVoidAsync("showToastr", "info", "Here is some information for you.");
        await _JSRuntime.ToastInfo("Here is some information for you");
    }

    private async Task ToastWarning()
    {
        //await _JSRuntime.InvokeVoidAsync("showToastr", "warning", "This is a warning message.");
        await _JSRuntime.ToastWarning("This is a warning for you");
    }


    private async Task SweetAlertSuccess()
    {
        await _JSRuntime.InvokeVoidAsync("ShowSwal", "success", "You clicked the button!");
    }

    private async Task SweetAlertError()
    {
        await _JSRuntime.InvokeVoidAsync("ShowSwal", "error", "Something went wrong!");
    }

    private async Task SweetAlertInfo()
    {
        await _JSRuntime.InvokeVoidAsync("ShowSwal", "info", "success");
    }

    private async Task SweetAlertWarning()
    {
        await _JSRuntime.InvokeVoidAsync("ShowSwal", "warning", "Do you want to save the changes?");
    }
}



