@page "/learn-blazor/blazor-js"
@inject IJSRuntime _JSRuntime

<h3>BlazorJs</h3>
<br />

<div class="row">
    <button class="btn btn-secondary" @onclick="ConfirmAction">Confirm Button</button>
</div>

<div>
    @if (ConfirmResult)
    {
        <p>Confirmation has been made!</p>
    }
    else
    {
        <p>Pending Confirmation</p>
    }
</div>

<div class="row">
    <button class="btn btn-success" @onclick="ViewResult">View Result</button>
</div>

<div>
    @if (ViewResultStatus)
    {
        <p>You pass the test. Congratulations</p>
    }
    else
    {
        <p>The result view here</p>
    }
</div>

<div class="row">
    <button class="btn btn-success" @onclick="ToastSuccess">Toastr success </button>
    <button class="btn btn-danger" @onclick="ToastError">Toastr error </button>

    <button class="btn btn-info" @onclick="ToastInfo">Toastr info </button>
    <button class="btn btn-warning" @onclick="ToastWarning">Toastr warning </button>

</div>

@code {

    private string ConfirmMessage = "Are you sure you want to proceed?";

    private string Message = "Do you want to View the Result?";

    private bool ConfirmResult { get; set; }

    private bool ViewResultStatus { get; set; }

    private async Task ConfirmAction()
    {
        ConfirmResult = await _JSRuntime.InvokeAsync<bool>("confirm", ConfirmMessage);
    }

    private async Task ViewResult()
    {
        ViewResultStatus = await _JSRuntime.InvokeAsync<bool>("confirm", Message);
    }


    private async Task ToastSuccess()
    {
        await _JSRuntime.InvokeVoidAsync("showToastr", "success", "Operation Successful");
    }

    private async Task ToastError()
    {
        await _JSRuntime.InvokeVoidAsync("showToastr", "error", "Operation Failed");
    }

    private async Task ToastInfo()
    {
        await _JSRuntime.InvokeVoidAsync("showToastr", "info", "Here is some information for you.");
    }

    private async Task ToastWarning()
    {
        await _JSRuntime.InvokeVoidAsync("showToastr", "warning", "This is a warning message.");
	}

}


